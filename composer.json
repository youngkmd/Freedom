{
    "name": "youngkmd/freedom",
    "description": "Freedom Manager - A powerful file and project management system",
    "version": "v1.0.0",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Kadiri Mohamed Redha",
            "email": "kaderkmd34@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
