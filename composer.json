{
    "name": "youngkmd/freedom",
    "description": "Freedom Manager - A powerful file and project management system",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Kadiri Mohamed Redha",
            "email": "kaderkmd34@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-zip": "*"
    },
    "autoload": {
    "psr-4": {
        "App\\": "src/",
        "App\\Controllers\\": "src/Controllers/",
        "App\\Services\\": "src/Services/",
        "App\\Utils\\": "src/Utils/"
    }
},
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
